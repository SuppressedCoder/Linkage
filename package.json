{
  "name": "linkage",
  "version": "0.2.0",
  "private": true,
  "description": "Controller bindings for WPILib command-based robots: click a controller picture, see conflicts, copy configureBindings().",
  "type": "module",
  "scripts": {
    "start": "node scripts/ensure-electron.mjs && electron .",
    "test": "node --test test/*.test.js",
    "uitest": "node scripts/uitest.mjs",
    "dist": "node scripts/ensure-electron.mjs && electron-builder",
    "serve": "python3 -m http.server 8000",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "playwright": "^1.63.0"
  },
  "main": "electron/main.js",
  "author": "RoboticsIsEpik"
}
